    {
      "parameters": {
        "jsCode": "// Contract with the edge: return { result: \"<speakable string>\" }.\n// verify_identity MUST start with VERIFIED or NOT_VERIFIED; the edge rewrites the wording\n// and records the outcome in call_state, so this workflow never decides access itself.\nconst tool = $('Signature valid?').item.json.tool;\nconst r = $json;\nlet result;\nif (r.error) {\n  // SoR failed/timed out: never let a failure read as \"no slots\" or \"not verified\".\n  return [{ json: { result: \"I'm having trouble reaching our system right now. I can transfer you to a team member.\" } }];\n}\nswitch (tool) {\n  case 'verify_identity':\n    result = r.match === true ? 'VERIFIED' : 'NOT_VERIFIED';\n    break;\n  case 'check_availability': {\n    const slots = (r.slots || []).slice(0, 3);\n    result = slots.length\n      ? 'I have ' + slots.map(s => `${s.spoken} (slot ${s.id})`).join(', or ') + '. Which works best?'\n      : \"I don't see anything open then. Would a different day work?\";\n    break;\n  }\n  case 'book_appointment':\n    result = r.confirmed ? `You're booked for ${r.spoken}. You'll get a text confirmation.` : \"That slot was just taken. Want me to check other times?\";\n    break;\n  case 'log_callback_request':\n    result = 'Got it. Someone from our team will call you back.';\n    break;\n  default:\n    result = \"I can't help with that one, but I can transfer you.\";\n}\nreturn [{ json: { result: result.slice(0, 500) } }];"
      },
      "id": "7c9615c3-a290-5326-af60-79a12c860e6f",
      "name": "Format speakable result",
