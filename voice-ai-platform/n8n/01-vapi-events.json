    {
      "parameters": {
        "jsCode": "// Verify the edge worker's HMAC so n8n never trusts the public internet.\n// Requires NODE_FUNCTION_ALLOW_BUILTIN=crypto. Signing key from env (or an n8n credential).\nconst crypto = require('crypto');\nconst key = $env.EDGE_N8N_SIGNING_KEY;\nconst out = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const h = item.json.headers || {};\n  const ts = Number(h['x-edge-timestamp'] || 0);\n  // Webhook option rawBody=true exposes exact bytes; fall back to re-serialising the\n  // parsed JSON (byte-identical when the sender used JSON.stringify, as the edge does).\n  let raw;\n  try { raw = (await this.helpers.getBinaryDataBuffer(i, 'data')).toString('utf8'); }\n  catch { raw = JSON.stringify(item.json.body); }\n  const expected = crypto.createHmac('sha256', key).update(`${ts}.${raw}`).digest('hex');\n  const given = Buffer.from(String(h['x-edge-signature'] || ''), 'utf8');\n  const fresh = Math.abs(Date.now() / 1000 - ts) <= 300;\n  const valid = fresh && given.length === expected.length &&\n                crypto.timingSafeEqual(given, Buffer.from(expected, 'utf8'));\n  out.push({ json: { valid, requestId: h['x-request-id'] || null, ...item.json.body } });\n}\nreturn out;"
      },
