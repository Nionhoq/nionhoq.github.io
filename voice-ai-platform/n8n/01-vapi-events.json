    {
      "parameters": {
        "jsCode": "// Minimise before anything else touches the payload (GDPR Art. 5(1)(c), HIPAA minimum necessary).\n// Only fields below leave this node; the raw transcript is never stored here.\nconst m = $json.message || {};\nconst call = m.call || {};\nconst a = m.analysis || {};\nreturn [{ json: {\n  tenantId: $json.tenantId,\n  type: m.type,\n  idemKey: m.type === 'end-of-call-report' ? `${call.id}:eocr` : `${call.id}:${m.status || m.type}`,\n  call: {\n    id: call.id,\n    direction: call.type === 'outboundPhoneCall' ? 'outbound' : 'inbound',\n    status: m.type === 'end-of-call-report' ? 'ended' : (m.status || 'unknown'),\n    endedReason: m.endedReason || null,\n    startedAt: m.startedAt || call.startedAt || null,\n    endedAt: m.endedAt || call.endedAt || null,\n    cost: m.cost ?? null,\n    summary: a.summary || null,          // assistant disables summaries for HIPAA tenants\n  },\n  structured: a.structuredData || {},\n}}];"
      },
